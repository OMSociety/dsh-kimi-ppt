{
  "name": "dsh-kimi-ppt",
  "version": "1.1.0",
  "type": "module",
  "description": "DeepSeek Harness plugin that bundles the kimi-ppt skill: create, edit and export PPT / slides / presentations as a locally generated .pptx with Pillow-rendered previews, no browser needed.",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/dsh-kimi-ppt#readme",
  "bugs": "https://github.com/OMSociety/dsh-kimi-ppt/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-kimi-ppt.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kimi",
    "ppt",
    "pptx",
    "slides",
    "presentation",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
